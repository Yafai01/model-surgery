# Model Surgery — optional server-side settings for the LOCAL app (the Vercel browser edition uses none).
# None of these are secrets. Set them in your shell (or in ~/.model_surgery/config.json using the lower-case
# keys shown in README) — the app does not read this file automatically.

# Folder containing llama.cpp binaries: llama-server (inference) and llama-quantize (quantization).
MODEL_SURGERY_LLAMA_CPP_DIR=C:\tools\llamacpp\bin

# HF → GGUF conversion: a llama.cpp checkout's convert script and a Python that has its requirements.
MODEL_SURGERY_CONVERT_SCRIPT=C:\src\llama.cpp\convert_hf_to_gguf.py
MODEL_SURGERY_CONVERT_PYTHON=C:\src\llama.cpp\.venv\Scripts\python.exe

# Restrict which folders can be browsed/scanned/loaded (os.pathsep-separated: ";" on Windows, ":" elsewhere).
# Empty = any local path. The outputs folder is always allowed.
MODEL_SURGERY_ALLOWED_ROOTS=D:\models;C:\Users\you\models

# Where quantized/converted files are written (default: <data dir>/outputs).
MODEL_SURGERY_OUTPUT_DIR=

# History database, config file and default outputs (default: ~/.model_surgery).
MODEL_SURGERY_DATA_DIR=

# Serve a different frontend build (default: frontend/dist next to the backend).
MODEL_SURGERY_FRONTEND_DIST=

# --- test-only ----------------------------------------------------------------------------------
# Backend opt-in real-model test (pytest):
MODEL_SURGERY_TEST_GGUF=
# Playwright real-inference test (npm run test:e2e):
E2E_LLAMA_CPP_DIR=
E2E_GGUF=
